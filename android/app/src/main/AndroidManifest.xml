<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ====================================================== -->
    <!-- PERMISSIONS -->
    <!-- ====================================================== -->

    <!-- Internet: required for Google Places API and Supabase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location: required for Blind Box nearby search -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ====================================================== -->
    <!-- APPLICATION -->
    <!-- ====================================================== -->

    <application
        android:label="MYsteryLane"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- ================================================== -->
        <!-- GOOGLE MAPS API KEY -->
        <!-- ================================================== -->

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCVm6fQkisMcN9gB59M7iekJapZuRvEYWw" />

        <!-- ================================================== -->
        <!-- MAIN ACTIVITY -->
        <!-- ================================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Flutter normal theme -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- ================================================== -->
            <!-- NORMAL APP LAUNCH -->
            <!-- ================================================== -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ================================================== -->
            <!-- REGISTRATION / EMAIL VERIFICATION DEEP LINK -->
            <!--
                 Used by:
                 mysterylane://login-callback
            -->
            <!-- ================================================== -->

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="mysterylane"
                    android:host="login-callback" />
            </intent-filter>

            <!-- ================================================== -->
            <!-- FORGOT PASSWORD / PASSWORD RECOVERY DEEP LINK -->
            <!--
                 Used by:
                 mysterylane://reset-password-callback
            -->
            <!-- ================================================== -->

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="mysterylane"
                    android:host="reset-password-callback" />
            </intent-filter>

        </activity>

        <!-- ====================================================== -->
        <!-- FLUTTER EMBEDDING -->
        <!-- ====================================================== -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- ========================================================== -->
    <!-- QUERIES -->
    <!-- ========================================================== -->

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />

            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>